{
 "schema": "motion.v1",
 "id": "attack_hammer_overhead",
 "structure": "brute_hammer",
 "fps": 60,
 "loop": false,
 "intent": "A heavy overhead hammer smash toward a target on the right: readable wind-up, a fast committed swing driven by the body, a held impact, then a weighted recovery back to the idle stance.",
 "pose_channels": {
  "pelvis": "[dx, dy] px offset of the pelvis from rest (root motion, crouch)",
  "spine": "deg, chest rotation about the pelvis (lean); + = forward (clockwise, toward the target)",
  "neck": "deg about the chest",
  "head": "deg about the neck",
  "arm_f": "hammer arm by IK: reach = shoulder-to-hand distance px, dir = deg of the hand seen from the shoulder in the chest frame, hammer = deg of the hammer axis in the chest frame (0 = +x)",
  "arm_b": "free arm by FK: shoulder, elbow deg offsets",
  "feet": "per contact [dx, 0]; a dx change between keys is a step with an automatic lift arc"
 },
 "phases": [
  {
   "name": "idle",
   "start": 0,
   "end": 8,
   "purpose": "ready stance"
  },
  {
   "name": "anticipation",
   "start": 8,
   "end": 18,
   "purpose": "small dip and counter-move that announces the wind-up"
  },
  {
   "name": "windup",
   "start": 18,
   "end": 46,
   "purpose": "weight sinks onto the back leg (crouch, not a rise: the legs are near straight at rest), chest arches back, hammer swung back over the head; brief hold at the top"
  },
  {
   "name": "swing",
   "start": 46,
   "end": 54,
   "purpose": "fast accelerating arc driven by hips then chest then arm; front foot steps in"
  },
  {
   "name": "impact",
   "start": 54,
   "end": 62,
   "purpose": "contact held (hit-stop), body sunk onto the front leg"
  },
  {
   "name": "follow_through",
   "start": 62,
   "end": 70,
   "purpose": "hammer and chest continue past the contact and settle"
  },
  {
   "name": "recovery",
   "start": 70,
   "end": 96,
   "purpose": "rise, pull the hammer back up, weight back to centre"
  },
  {
   "name": "return_to_idle",
   "start": 96,
   "end": 120,
   "purpose": "step the front foot back and settle into the ready stance"
  }
 ],
